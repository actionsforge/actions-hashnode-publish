{
  "name": "actions-hashnode-publish",
  "version": "1.0.0",
  "description": "GitHub Action to publish markdown articles to Hashnode from a GitHub repository using GraphQL API",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsup && npm run clean-dist",
    "clean-dist": "find dist -type f ! -name 'index.js' ! -name 'cli.js' ! -name 'index.d.ts' -delete",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@actions/github": "^9.1.1",
    "@actions/io": "^1.1.3",
    "axios": "^1.16.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "github",
    "hashnode",
    "github-actions",
    "markdown",
    "publishing"
  ],
  "author": "John Ajera",
  "license": "MIT"
}
